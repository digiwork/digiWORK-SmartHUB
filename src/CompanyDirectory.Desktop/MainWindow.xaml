<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CompanyDirectory_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="digiWORK SmartHUB">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasek powiadomień (aktualizacje, wiadomości wymagające potwierdzenia) -->
        <StackPanel Grid.Row="0" Spacing="4" Padding="8,4,8,0">
            <InfoBar
                x:Name="UpdateInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />
            <InfoBar
                x:Name="MessageInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Closed="OnMessageInfoBarClosed" />
        </StackPanel>

        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Szukaj" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#0078D4"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Struktura" Tag="org">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Foreground="#8764B8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ulubieni" Tag="fav">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB900"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ostatnie" Tag="recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#CA5010"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Czat" Tag="chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Foreground="#498205"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.ChatUnreadCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ChatUnreadBadgeVisibility, Mode=OneWay}"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="SMS" Tag="sms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" FontFamily="Segoe MDL2 Assets" Foreground="#038387"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Odebrane" Tag="inbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="#D13438"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.UnreadCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.UnreadBadgeVisibility, Mode=OneWay}"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ustawienia" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#8a8886"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <ToggleSwitch
                    Header="Tryb ciemny"
                    IsOn="{x:Bind ViewModel.IsDarkMode, Mode=TwoWay}"
                    Margin="16,0,0,12"/>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Pasek statusu -->
        <Border Grid.Row="2"
                Padding="12,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusSignalR, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.StatusVersion}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
