<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CompanyDirectory_Desktop.Views.AdminMessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Wyślij wiadomość — digiWORK SmartHUB">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Temat -->
        <StackPanel Spacing="4">
            <TextBlock Text="Temat" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox
                Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Temat wiadomości…" />
        </StackPanel>

        <!-- Treść — nagłówek -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Treść" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <!-- Treść — pole wieloliniowe -->
        <TextBox
            Grid.Row="2"
            Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="Treść wiadomości…"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top" />

        <!-- Wymaga potwierdzenia -->
        <ToggleSwitch
            Grid.Row="3"
            Header="Wymaga potwierdzenia przeczytania"
            IsOn="{x:Bind ViewModel.RequiresConfirmation, Mode=TwoWay}"
            OnContent="Tak"
            OffContent="Nie" />

        <!-- Przycisk Wyślij + ProgressRing -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*"    />
            </Grid.ColumnDefinitions>
            <Button
                Content="Wyślij wiadomość"
                Command="{x:Bind ViewModel.SendCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing
                Grid.Column="1"
                IsActive="{x:Bind ViewModel.IsSending, Mode=OneWay}"
                Width="20" Height="20" />
        </Grid>

        <!-- Status -->
        <TextBlock
            Grid.Row="5"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
