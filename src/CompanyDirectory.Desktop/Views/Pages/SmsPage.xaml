<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanyDirectory_Desktop.Views.Pages.SmsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:CompanyDirectory.Shared.Dtos"
    xmlns:vm="using:CompanyDirectory_Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pasek tytułu -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="Wyślij SMS hurtowy"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <ProgressRing
                Grid.Column="1"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="20" Height="20" VerticalAlignment="Center" />
        </Grid>

        <!-- Zawartość -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lewa kolumna: odbiorcy -->
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="Odbiorcy"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Szukaj pracownika, aby dodać…" />

                <ListView
                    Grid.Row="2"
                    x:Name="SearchResultsListView"
                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}"
                    MaxHeight="180"
                    IsItemClickEnabled="True"
                    ItemClick="OnSearchResultItemClick"
                    SelectionMode="None"
                    BorderBrush="{ThemeResource SystemFillColorNeutralBrush}"
                    BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:UserDirectoryEntryDto">
                            <Grid Padding="4,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Mobile}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="1"
                                    Glyph="&#xE710;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Lista odbiorców -->
                <Grid Grid.Row="3" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.SendButtonText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Wyczyść"
                            Command="{x:Bind ViewModel.SelectClearCommand}"
                            Padding="8,4" MinWidth="0"
                            Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        x:Name="RecipientsListView"
                        ItemsSource="{x:Bind ViewModel.Recipients, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SmsRecipientEntry">
                                <Grid Padding="4,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind User.DisplayName}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind MobileDisplay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Tag="{x:Bind}"
                                        Click="OnRemoveRecipientClick"
                                        ToolTipService.ToolTip="Usuń odbiorcę"
                                        Padding="6,4" MinWidth="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Prawa kolumna: treść + wyślij -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        Text="Treść SMS"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CharCountDisplay, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <TextBox
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Wpisz treść wiadomości SMS…"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxLength="459"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top" />

                <TextBlock
                    Grid.Row="2"
                    Text="{x:Bind ViewModel.SenderDisplay, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button
                    Grid.Row="3"
                    Content="{x:Bind ViewModel.SendButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SendCommand}"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>

        <!-- Pasek statusu -->
        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
