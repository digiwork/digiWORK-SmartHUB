<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanyDirectory_Desktop.Views.Pages.OrgChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CompanyDirectory_Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="Struktura organizacyjna"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <ProgressRing
                Grid.Column="1"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Width="20" Height="20" VerticalAlignment="Center" />
            <Button
                Grid.Column="2"
                Content="Odśwież"
                Command="{x:Bind ViewModel.LoadCommand}"
                VerticalAlignment="Center" />
        </Grid>

        <TreeView
            x:Name="OrgTreeView"
            Grid.Row="1"
            SelectionMode="Single"
            ItemInvoked="OnNodeInvoked">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,3">
                        <!-- OU folder — purple -->
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="#8764B8"
                                  Visibility="{Binding Content.FolderVisibility}" />
                        <!-- User leaf — blue -->
                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="#0078D4"
                                  Visibility="{Binding Content.PersonVisibility}" />
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Content.Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding Content.Role}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
