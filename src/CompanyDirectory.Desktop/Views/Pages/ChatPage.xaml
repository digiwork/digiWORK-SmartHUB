<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanyDirectory_Desktop.Views.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:CompanyDirectory.Shared.Dtos"
    xmlns:vm="using:CompanyDirectory_Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Lewa kolumna: lista rozmów ──────────────────────── -->
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            <TextBlock
                Text="Rozmowy"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Margin="12,4,12,8" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ConversationSummaryDto">
                        <Grid Padding="4,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="{x:Bind OtherDisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind LastMessagePreview}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind UnreadCount}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemAccentColor}"
                                FontWeight="Bold"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ── Prawa kolumna: okno czatu ───────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Nagłówek rozmowy (widoczny tylko gdy wybrana rozmowa) -->
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorNeutralBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{x:Bind ViewModel.ChatPanelVisibility, Mode=OneWay}">
                <Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedConversation.OtherDisplayName, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.BusyIndicatorVisibility, Mode=OneWay}"
                        Width="18" Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Lista wiadomości -->
            <ScrollViewer
                Grid.Row="1"
                x:Name="MessagesScrollViewer"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.ChatPanelVisibility, Mode=OneWay}">
                <ItemsControl
                    x:Name="MessagesItemsControl"
                    ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageEntry">
                            <Grid Margin="0,3">
                                <!-- Własna wiadomość — po prawej -->
                                <Border
                                    HorizontalAlignment="Right"
                                    MaxWidth="420"
                                    CornerRadius="14,14,2,14"
                                    Background="{ThemeResource SystemAccentColor}"
                                    Padding="12,8"
                                    Visibility="{x:Bind OwnVisibility}">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Text="{x:Bind Message.Body}"
                                            TextWrapping="Wrap"
                                            Foreground="White" />
                                        <TextBlock
                                            Text="{x:Bind TimeDisplay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="White"
                                            Opacity="0.75"
                                            HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                                <!-- Wiadomość od rozmówcy — po lewej -->
                                <Border
                                    HorizontalAlignment="Left"
                                    MaxWidth="420"
                                    CornerRadius="14,14,14,2"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorNeutralBrush}"
                                    BorderThickness="1"
                                    Padding="12,8"
                                    Visibility="{x:Bind OtherVisibility}">
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Text="{x:Bind Message.FromDisplayName}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Message.Body}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind TimeDisplay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Placeholder gdy brak wybranej rozmowy -->
            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="Wybierz rozmowę lub zacznij nową z poziomu wyszukiwarki"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
            </StackPanel>

            <!-- Pasek wpisywania -->
            <Grid
                Grid.Row="2"
                Padding="12,8"
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.ChatPanelVisibility, Mode=OneWay}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorNeutralBrush}"
                BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="MessageInputBox"
                    Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Wpisz wiadomość…"
                    AcceptsReturn="False"
                    KeyDown="OnMessageInputKeyDown"
                    KeyUp="OnMessageInputKeyUp"
                    MaxLength="2000" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,8">
                    <FontIcon Glyph="&#xE725;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
